<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100D24">

    <!-- 우주 배경 PNG -->
    <ImageView
        android:id="@+id/galaxyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_galaxy"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>

    <!-- 기존 은하계 화면 -->
    <FrameLayout
        android:id="@+id/galaxyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 우측 상단 은하계 이름 -->
    <TextView
        android:id="@+id/textGalaxyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:maxWidth="170dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:background="@drawable/bg_galaxy_name"
        android:textColor="#F4E8FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- 태양계 메뉴가 열리면 어두워지는 영역 -->
    <View
        android:id="@+id/solarDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000616"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- 태양 중심 궤도 메뉴 (평소에는 invisible, 크기는 유지해서 위치 계산 가능) -->
    <com.example.starring.SolarOrbitMenuView
        android:id="@+id/solarMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"/>

    <!-- 하단 중앙 고정 태양 PNG -->
    <ImageView
        android:id="@+id/btnSun"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:src="@drawable/solar_sun"
        android:scaleType="fitCenter"
        android:contentDescription="태양계 메뉴 열기"
        android:clickable="true"
        android:focusable="true"/>

</FrameLayout>
