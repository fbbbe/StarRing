<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.starring.common.StarFieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/textGalaxyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/galaxy_placeholder_title"
            android:textColor="@color/star_gold"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- TEMP: 별자리 이미지 로드 확인용. 확인 후 삭제 -->
        <ImageView
            android:id="@+id/tempConstellation"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/constellation_01" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlink"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/action_unlink"
            android:textColor="@color/error_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_logout"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</FrameLayout>
