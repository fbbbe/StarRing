<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".StarRingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StarRing">

        <!-- 임시 시작 화면: 은하계 메인 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 우주 재판장 메인 -->
        <activity
            android:name=".court.CourtMainActivity"
            android:exported="false" />

        <!-- 블랙홀 생성 -->
        <activity
            android:name=".court.CourtWriteActivity"
            android:exported="false" />

        <!-- 우주 재판장 투표 -->
        <activity
            android:name=".court.CourtVoteActivity"
            android:exported="false" />

        <!-- 내 블랙홀 목록 -->
        <activity android:name=".court.CourtMyBlackholesActivity"
            android:exported="false" />

        <!-- 화해 -->
        <activity android:name=".court.CourtReconcileActivity"
            android:exported="false" />

        <!-- 로그인 -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 회원가입 -->
        <activity
            android:name=".auth.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 커플 연동 -->
        <activity
            android:name=".couple.CoupleLinkActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 은하계 임시 화면 -->
        <activity
            android:name=".galaxy.GalaxyPlaceholderActivity"
            android:exported="false" />

        <!-- 행성 생성 -->
        <activity
            android:name=".PlanetCreateActivity"
            android:exported="false" />

        <!-- 만난 날짜 / 은하계 이름 설정 -->
        <activity
            android:name=".GalaxySetupActivity"
            android:exported="false"/>

        <!-- 은하계 생성 로딩 -->
        <activity
            android:name=".GalaxyLoadingActivity"
            android:exported="false"/>

        <!-- 실제 은하계 메인 -->
        <activity
            android:name=".GalaxyActivity"
            android:exported="false"/>

        <activity
            android:name=".PlanetDetailActivity"
            android:exported="false" />

        <activity
            android:name=".GalaxyDestroyActivity"
            android:exported="false" />

        <activity
            android:name=".GalaxyRenameActivity"
            android:exported="false" />

        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
