rules_version = '2';

// StarRing Firestore 보안 규칙
// 이 파일이 원본. Firebase 콘솔에는 수동 배포 (수정하면 콘솔에도 반영할 것).
//   메인 화면/블랙홀/행성 등 다른 컬렉션 규칙은 각 담당자가 아래에 추가 (맨 아래 임시 허용 블록은 그때 삭제).
//
// 구조: users/{uid}, galaxies/{galaxyId}, inviteCodes/{code}
// galaxies.startDate = 만난 날 (UTC 00:00 Timestamp, 현재 선택 필드)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function galaxyPath(galaxyId) {
      return /databases/$(database)/documents/galaxies/$(galaxyId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    // 변경된 필드가 허용 목록 안에만 있는지
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 만난 날(startDate) 값 검증. 앱의 StartDatePolicy와 같은 기준.
    //  - 날짜만 의미 있으므로 UTC 00:00 값만 허용 (d == d.date())
    //  - 하한 1950-01-01 (오타 방지)
    //  - 상한 "오늘": 사용자 시간대의 오늘을 UTC 00:00으로 저장하므로
    //    KST 오전 9시 전에는 서버 시각보다 미래가 된다 → request.time + 1일까지 허용
    function validStartDate(d) {
      return d is timestamp
        && d == d.date()
        && d >= timestamp.date(1950, 1, 1)
        && d <= request.time + duration.value(1, 'd');
    }

    // 초대코드 유효기간 (생성 후 24시간). 기간을 바꾸려면 여기만 수정.
    function inviteNotExpired(code) {
      return request.time < get(invitePath(code)).data.createdAt + duration.value(24, 'h');
    }

    // ───────────────────────── users ─────────────────────────
    match /users/{uid} {
      // 본인, 또는 같은 은하계 상대방만 읽기 (닉네임 표시용)
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        (resource.data.galaxyId != null &&
         request.auth.uid in get(galaxyPath(resource.data.galaxyId)).data.memberUids)
      );
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nickname', 'galaxyId', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.galaxyId == null
        && request.resource.data.createdAt == request.time;

      // 본인 문서만 수정. galaxyId는 null(해제/정리)이거나,
      // 같은 트랜잭션 결과 기준으로 내가 멤버인 은하계로만 설정 가능.
      allow update: if signedIn()
        && request.auth.uid == uid
        && onlyChanges(['nickname', 'galaxyId'])
        && (request.resource.data.galaxyId == null ||
            request.auth.uid in getAfter(galaxyPath(request.resource.data.galaxyId)).data.memberUids);

      allow delete: if false;
    }

    // ───────────────────────── galaxies ─────────────────────────
    match /galaxies/{galaxyId} {
      // [합류 케이스 고려]
      // 합류하는 사람은 아직 memberUids에 없으므로 "멤버만 읽기"로 잠그면 트랜잭션이 실패한다.
      // → status == 'waiting' 인 은하계는 로그인 사용자 누구나 단건 get 허용.
      //   galaxyId는 자동 ID라 추측이 불가능하고, 초대코드를 알아야만 얻을 수 있다.
      //   list(목록 조회)는 내가 멤버인 은하계로 한정 → 대기 중 은하계 목록 노출 방지.
      //   resource == null: 삭제된 은하계(대기 취소)를 조회해서 "없음"을 확인할 수 있게 허용.
      allow get: if signedIn() && (
        resource == null ||
        request.auth.uid in resource.data.memberUids ||
        resource.data.status == 'waiting'
      );
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;

      // 생성: 만든 사람 혼자, waiting 상태로만
      // startDate(만난 날)는 현재 "선택": 있으면 유효해야 함.
      //   구버전 앱(startDate 없이 생성)을 쓰는 팀원이 깨지지 않도록 필수로 두지 않음.
      //   없으면 앱이 bornAt 날짜로 대체 계산 (GalaxyDates.effectiveStart).
      //   TODO: 팀 전체가 새 빌드로 넘어가면 아래 줄을 validStartDate(request.resource.data.startDate)로 바꿔 필수화.
      allow create: if signedIn()
        && (!('startDate' in request.resource.data) || validStartDate(request.resource.data.startDate))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'waiting'
        && request.resource.data.inviteCode is string
        && request.resource.data.name == null
        && request.resource.data.bornAt == null
        && request.resource.data.createdAt == request.time;

      // 1) 합류: waiting → naming
      //    - 자기 자신(owner)은 불가, 이미 멤버인 사람 불가, 2명 초과 불가
      //    - 같은 트랜잭션에서 초대코드 문서를 삭제해야 함 (코드 무효화)
      //    - 초대코드 유효기간 내에서만
      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && request.auth.uid != resource.data.ownerUid
        && !(request.auth.uid in resource.data.memberUids)
        && resource.data.memberUids.size() == 1
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.status == 'naming'
        && request.resource.data.inviteCode == null
        && onlyChanges(['memberUids', 'status', 'inviteCode'])
        && inviteNotExpired(resource.data.inviteCode)
        && !existsAfter(invitePath(resource.data.inviteCode));

      // 2) 이름 설정: naming → active, bornAt = 서버 시각 (은하계 탄생)
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.status == 'naming'
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.bornAt == request.time
        && onlyChanges(['name', 'status', 'bornAt']);

      // 3) 대기 중 코드 재발급 (만료 시): inviteCode만 교체
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && resource.data.status == 'waiting'
        && request.resource.data.inviteCode is string
        && onlyChanges(['inviteCode']);

      // 4) 연동 해제: memberUids는 그대로 유지 (과거 기록 접근 유지 목적)
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.status in ['naming', 'active']
        && request.resource.data.status == 'unlinked'
        && request.resource.data.unlinkedAt == request.time
        && onlyChanges(['status', 'unlinkedAt']);

      // 5) 만난 날 수정: 연동된(naming/active) 은하계의 멤버 누구나, startDate만.
      //    startDate가 없던 기존 은하계에 처음 넣는 것도 이 규칙으로 허용.
      //    (수정 UI는 메뉴바 "내 정보" — GalaxyRepository.updateStartDate 사용)
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.status in ['naming', 'active']
        && validStartDate(request.resource.data.startDate)
        && onlyChanges(['startDate']);

      // 대기 취소: 만든 사람이 waiting 상태에서만 삭제
      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && resource.data.status == 'waiting';
    }

    // ───────────────────────── inviteCodes ─────────────────────────
    match /inviteCodes/{code} {
      // 코드를 아는 사람만 단건 조회 가능. 목록 조회(코드 훑어보기)는 금지.
      allow get: if signedIn();
      allow list: if false;

      // 생성: 헷갈리는 문자(0,O,1,I) 제외 6자리,
      // 같은 트랜잭션에서 만든 내 waiting 은하계와 연결돼 있어야 함
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(galaxyPath(request.resource.data.galaxyId)).data.ownerUid == request.auth.uid
        && getAfter(galaxyPath(request.resource.data.galaxyId)).data.status == 'waiting'
        && getAfter(galaxyPath(request.resource.data.galaxyId)).data.inviteCode == code;

      allow update: if false;

      // 삭제: 만든 사람(취소/재발급), 또는 합류 트랜잭션
      // (트랜잭션 결과에서 은하계가 이 코드를 더 이상 가리키지 않을 때)
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        getAfter(galaxyPath(resource.data.galaxyId)).data.inviteCode != code
      );
    }

    // ───────────────────────── 임시 허용 (팀원 담당 컬렉션) ─────────────────────────
    // ⚠ 임시 규칙: 각 담당자가 규칙을 추가하면 삭제할 것.
    //   로그인 사용자면 누구나 읽기/쓰기 가능 (하위 컬렉션 포함) → 실제 서비스 전에 반드시 교체.
    match /planets/{document=**} {
      allow read, write: if signedIn();
    }

    match /blackholes/{document=**} {
      allow read, write: if signedIn();
    }

    match /trials/{document=**} {
      allow read, write: if signedIn();
    }

    match /messages/{document=**} {
      allow read, write: if signedIn();
    }

    // Auth/Firestore 연결 테스트용 (문서 ID = uid). 자기 문서만.
    // ⚠ 임시 규칙: 테스트 화면을 없애면 삭제할 것.
    match /connection_tests/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
