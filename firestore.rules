
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function galaxyPath(galaxyId) {
      return /databases/$(database)/documents/galaxies/$(galaxyId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    // 변경 가능한 필드 제한
    function onlyChanges(keys) {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(keys);
    }

    // 만난 날짜 형식 검사
    function validDatingStartDate(date) {
      return date is string
      && date.matches(
        '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
      );
    }

    // 초대코드 24시간 유효
    function inviteNotExpired(code) {
      return request.time <
      get(invitePath(code)).data.createdAt
      + duration.value(24, 'h');
    }

    // ----------------------------------
    // 1. users
    // ----------------------------------

    match /users/{uid} {

      allow get: if signedIn() && (
        request.auth.uid == uid ||
        (
          resource.data.galaxyId != null &&
          request.auth.uid in get(
            galaxyPath(resource.data.galaxyId)
          ).data.memberUids
        )
      );

      allow list: if false;

      allow create: if signedIn()
      && request.auth.uid == uid
      && request.resource.data.keys().hasOnly([
        'email',
        'nickname',
        'galaxyId',
        'createdAt'
      ])
      && request.resource.data.nickname is string
      && request.resource.data.nickname.size() >= 1
      && request.resource.data.nickname.size() <= 12
      && request.resource.data.galaxyId == null
      && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
      && request.auth.uid == uid
      && onlyChanges(['nickname', 'galaxyId'])
      && (
        request.resource.data.galaxyId == null ||
        request.auth.uid in getAfter(
          galaxyPath(request.resource.data.galaxyId)
        ).data.memberUids
      );

      allow delete: if false;
    }

    // ----------------------------------
    // 2. galaxies
    // ----------------------------------

    match /galaxies/{galaxyId} {

      allow get: if signedIn() && (
        resource == null ||
        request.auth.uid in resource.data.memberUids ||
        resource.data.status == 'waiting'
      );

      allow list: if signedIn()
      && request.auth.uid in resource.data.memberUids;

      // 신규 은하계 생성
      // 이름과 만난 날짜를 미리 저장
      allow create: if signedIn()
      && request.resource.data.ownerUid == request.auth.uid
      && request.resource.data.memberUids == [request.auth.uid]
      && request.resource.data.status == 'waiting'
      && request.resource.data.inviteCode is string

      && request.resource.data.name is string
      && request.resource.data.name.size() >= 1
      && request.resource.data.name.size() <= 20

      && validDatingStartDate(
        request.resource.data.datingStartDate
      )

      && request.resource.data.bornAt == null
      && request.resource.data.createdAt == request.time;

      // ----------------------------------
      // 초대코드 입력 및 합류
      // waiting → naming
      // ----------------------------------

      allow update: if signedIn()
      && resource.data.status == 'waiting'
      && request.auth.uid != resource.data.ownerUid
      && !(request.auth.uid in resource.data.memberUids)
      && resource.data.memberUids.size() == 1

      && request.resource.data.memberUids ==
      resource.data.memberUids.concat([request.auth.uid])

      && request.resource.data.status == 'naming'
      && request.resource.data.inviteCode == null

      && onlyChanges([
        'memberUids',
        'status',
        'inviteCode'
      ])

      && inviteNotExpired(resource.data.inviteCode)
      && !existsAfter(
        invitePath(resource.data.inviteCode)
      );

      // ----------------------------------
      // 연동 완료 후 은하계 활성화
      // naming → active
      // ----------------------------------

      allow update: if signedIn()
      && request.auth.uid in resource.data.memberUids
      && resource.data.memberUids.size() == 2
      && resource.data.status == 'naming'
      && request.resource.data.status == 'active'

      // 이름은 이미 저장된 상태
      && resource.data.name is string
      && resource.data.name.size() >= 1
      && resource.data.name.size() <= 20

      // 만난 날짜도 이미 저장된 상태
      && validDatingStartDate(
        resource.data.datingStartDate
      )

      // 은하계 탄생 시각은 서버 시간
      && request.resource.data.bornAt == request.time

      // 활성화 시 상태와 탄생 시각만 변경
      && onlyChanges([
        'status',
        'bornAt'
      ]);

      // ----------------------------------
      // 기존 은하계의 만난 날짜 추가
      // 최초 한 번만 저장 가능
      // ----------------------------------

      allow update: if signedIn()

      // 해당 은하계 구성원만 가능
      && request.auth.uid in resource.data.memberUids

      // 이미 생성된 은하계
      && resource.data.status == 'active'

      // 기존에 날짜가 없을 때만
      && resource.data.get('datingStartDate', null) == null

      // 날짜 형식 검사
      && validDatingStartDate(
        request.resource.data.datingStartDate
      )

      // 다른 정보 변경 금지
      && onlyChanges([
        'datingStartDate'
      ]);

      // ----------------------------------
      // 초대코드 재발급
      // ----------------------------------

      allow update: if signedIn()
      && request.auth.uid == resource.data.ownerUid
      && resource.data.status == 'waiting'
      && request.resource.data.inviteCode is string
      && onlyChanges(['inviteCode']);

      // ----------------------------------
      // 연동 해제
      // ----------------------------------

      allow update: if signedIn()
      && request.auth.uid in resource.data.memberUids
      && resource.data.status in ['naming', 'active']
      && request.resource.data.status == 'unlinked'
      && request.resource.data.unlinkedAt == request.time
      && onlyChanges([
        'status',
        'unlinkedAt'
      ]);

      // waiting 상태에서 생성 취소
      allow delete: if signedIn()
      && request.auth.uid == resource.data.ownerUid
      && resource.data.status == 'waiting';
    }

    // ----------------------------------
    // 3. inviteCodes
    // ----------------------------------

    match /inviteCodes/{code} {

      allow get: if signedIn();

      allow list: if false;

      // 초대코드 생성
      allow create: if signedIn()
      && code.matches('^[A-HJ-NP-Z2-9]{6}$')
      && request.resource.data.ownerUid == request.auth.uid
      && request.resource.data.createdAt == request.time

      && getAfter(
        galaxyPath(request.resource.data.galaxyId)
      ).data.ownerUid == request.auth.uid

      && getAfter(
        galaxyPath(request.resource.data.galaxyId)
      ).data.status == 'waiting'

      && getAfter(
        galaxyPath(request.resource.data.galaxyId)
      ).data.inviteCode == code;

      allow update: if false;

      // 코드 삭제 및 무효화
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        getAfter(
          galaxyPath(resource.data.galaxyId)
        ).data.inviteCode != code
      );
    }

    // ───────────────────────── 임시 허용 (팀원 담당 컬렉션) ─────────────────────────
    // ⚠ 임시 규칙: 각 담당자가 규칙을 추가하면 삭제할 것.
    //   로그인 사용자면 누구나 읽기/쓰기 가능 (하위 컬렉션 포함) → 실제 서비스 전에 반드시 교체.
    match /planets/{document=**} {
      allow read, write: if signedIn();
    }

    match /blackholes/{document=**} {
      allow read, write: if signedIn();
    }

    match /trials/{document=**} {
      allow read, write: if signedIn();
    }

    match /messages/{document=**} {
      allow read, write: if signedIn();
    }

    // Auth/Firestore 연결 테스트용 (문서 ID = uid). 자기 문서만.
    // ⚠ 임시 규칙: 테스트 화면을 없애면 삭제할 것.
    match /connection_tests/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
