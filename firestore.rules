
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================
    // 공통 함수
    // ==================================

    function signedIn() {
      return request.auth != null;
    }

    function galaxyPath(galaxyId) {
      return /databases/$(database)/documents/galaxies/$(galaxyId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    function onlyChanges(keys) {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(keys);
    }

    function validNickname(nickname) {
      return nickname is string
      && nickname.size() >= 1
      && nickname.size() <= 12;
    }

    function validGalaxyName(name) {
      return name is string
      && name.size() >= 1
      && name.size() <= 20;
    }

    function validDatingStartDate(date) {
      return date is string
      && date.matches(
        '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
      );
    }

    function validInviteCode(code) {
      return code is string
      && code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    // 초대코드 검증
    // 존재 여부, 소유자, 은하계, 만료시간,
    // 트랜잭션 내 코드 삭제까지 확인
    function validInviteForJoin(code, galaxyId, ownerUid) {
      return validInviteCode(code)
      && exists(invitePath(code))
      && get(invitePath(code)).data.galaxyId == galaxyId
      && get(invitePath(code)).data.ownerUid == ownerUid
      && get(invitePath(code)).data.createdAt is timestamp
      && request.time >= get(invitePath(code)).data.createdAt
      && request.time <
      get(invitePath(code)).data.createdAt
      + duration.value(24, 'h')
      && !existsAfter(invitePath(code));
    }

    // 은하계의 정상 구성원인지 확인
    function isActiveGalaxyMember(galaxyId) {
      return signedIn()
      && exists(galaxyPath(galaxyId))
      && get(galaxyPath(galaxyId)).data.status
      in ['naming', 'active']
      && request.auth.uid in
      get(galaxyPath(galaxyId)).data.memberUids;
    }


    // ==================================
    // 1. users
    // ==================================

    match /users/{uid} {

      // 본인 또는 현재 같은 은하계의 구성원만 조회
      allow get: if signedIn() && (
        request.auth.uid == uid
        ||
        (
          resource.data.get('galaxyId', null) is string
          && isActiveGalaxyMember(resource.data.galaxyId)
          && uid in get(
            galaxyPath(resource.data.galaxyId)
          ).data.memberUids
        )
      );

      allow list: if false;

      // 회원 정보 생성
      allow create: if signedIn()
      && request.auth.uid == uid

      && request.resource.data.keys().hasOnly([
        'email',
        'nickname',
        'galaxyId',
        'createdAt'
      ])

      && request.resource.data.keys().hasAll([
        'email',
        'nickname',
        'galaxyId',
        'createdAt'
      ])

      && request.resource.data.email is string
      && request.resource.data.email
      == request.auth.token.email

      && validNickname(
        request.resource.data.nickname
      )

      && request.resource.data.galaxyId == null
      && request.resource.data.createdAt == request.time;

      // 회원 정보 수정
      allow update: if signedIn()
      && request.auth.uid == uid

      && onlyChanges([
        'nickname',
        'galaxyId'
      ])

      && validNickname(
        request.resource.data.nickname
      )

      && (
        request.resource.data.galaxyId == null
        ||
        (
          request.resource.data.galaxyId is string
          && request.auth.uid in getAfter(
            galaxyPath(request.resource.data.galaxyId)
          ).data.memberUids

          && getAfter(
            galaxyPath(request.resource.data.galaxyId)
          ).data.status in [
            'waiting',
            'naming',
            'active'
          ]
        )
      );

      allow delete: if false;
    }


    // ==================================
    // 2. galaxies
    // ==================================

    match /galaxies/{galaxyId} {

      // 현재 구성원만 조회 가능
      // 연동 해제된 은하계는 조회 불가
      allow get: if signedIn()
      && resource.data.status != 'unlinked'
      && request.auth.uid in resource.data.memberUids;

      // 구성원 본인의 은하계만 목록 조회
      allow list: if signedIn()
      && resource.data.status != 'unlinked'
      && request.auth.uid in resource.data.memberUids;


      // ----------------------------------
      // 신규 은하계 생성
      // ----------------------------------

      allow create: if signedIn()

      && request.resource.data.keys().hasOnly([
        'ownerUid',
        'memberUids',
        'status',
        'inviteCode',
        'name',
        'datingStartDate',
        'bornAt',
        'createdAt'
      ])

      && request.resource.data.keys().hasAll([
        'ownerUid',
        'memberUids',
        'status',
        'inviteCode',
        'name',
        'datingStartDate',
        'bornAt',
        'createdAt'
      ])

      && request.resource.data.ownerUid
      == request.auth.uid

      && request.resource.data.memberUids
      == [request.auth.uid]

      && request.resource.data.status == 'waiting'

      && validInviteCode(
        request.resource.data.inviteCode
      )

      && validGalaxyName(
        request.resource.data.name
      )

      && validDatingStartDate(
        request.resource.data.datingStartDate
      )

      && request.resource.data.bornAt == null
      && request.resource.data.createdAt == request.time;


      // ----------------------------------
      // 초대코드 입력 및 커플 합류
      // waiting -> naming
      // ----------------------------------

      allow update: if signedIn()

      && resource.data.status == 'waiting'

      && request.auth.uid != resource.data.ownerUid

      && !(request.auth.uid in resource.data.memberUids)

      && resource.data.memberUids
      == [resource.data.ownerUid]

      && request.resource.data.memberUids
      == resource.data.memberUids.concat([
        request.auth.uid
      ])

      && request.resource.data.status == 'naming'

      && request.resource.data.inviteCode == null

      && onlyChanges([
        'memberUids',
        'status',
        'inviteCode'
      ])

      // 실제 초대코드 문서의 정보 검증
      && validInviteForJoin(
        resource.data.inviteCode,
        galaxyId,
        resource.data.ownerUid
      );


      // ----------------------------------
      // 은하계 활성화
      // naming -> active
      // ----------------------------------

      allow update: if signedIn()

      && request.auth.uid in resource.data.memberUids

      && resource.data.memberUids.size() == 2

      && resource.data.status == 'naming'

      && request.resource.data.status == 'active'

      && validGalaxyName(
        resource.data.name
      )

      && validDatingStartDate(
        resource.data.datingStartDate
      )

      && request.resource.data.bornAt == request.time

      && onlyChanges([
        'status',
        'bornAt'
      ]);


      // ----------------------------------
      // 기존 은하계의 만난 날짜 추가
      // 최초 한 번만 가능
      // ----------------------------------

      allow update: if signedIn()

      && request.auth.uid in resource.data.memberUids

      && resource.data.status == 'active'

      && resource.data.get(
        'datingStartDate',
        null
      ) == null

      && validDatingStartDate(
        request.resource.data.datingStartDate
      )

      && onlyChanges([
        'datingStartDate'
      ]);


      // ----------------------------------
      // 초대코드 재발급
      // ----------------------------------

      allow update: if signedIn()

      && request.auth.uid == resource.data.ownerUid

      && resource.data.status == 'waiting'

      && validInviteCode(
        request.resource.data.inviteCode
      )

      && request.resource.data.inviteCode
      != resource.data.inviteCode

      && onlyChanges([
        'inviteCode'
      ])

      // 새 초대코드 문서가 있어야 함
      && existsAfter(
        invitePath(request.resource.data.inviteCode)
      )

      && getAfter(
        invitePath(request.resource.data.inviteCode)
      ).data.galaxyId == galaxyId

      && getAfter(
        invitePath(request.resource.data.inviteCode)
      ).data.ownerUid == request.auth.uid

      && getAfter(
        invitePath(request.resource.data.inviteCode)
      ).data.createdAt == request.time

      // 기존 초대코드는 삭제되어야 함
      && !existsAfter(
        invitePath(resource.data.inviteCode)
      );


      // ----------------------------------
      // 커플 연동 해제
      // ----------------------------------

      allow update: if signedIn()

      && request.auth.uid in resource.data.memberUids

      && resource.data.status in [
        'naming',
        'active'
      ]

      && request.resource.data.status == 'unlinked'

      && request.resource.data.unlinkedAt == request.time

      && onlyChanges([
        'status',
        'unlinkedAt'
      ]);


      // ----------------------------------
      // 대기 중인 은하계 생성 취소
      // ----------------------------------

      allow delete: if signedIn()

      && request.auth.uid == resource.data.ownerUid

      && resource.data.status == 'waiting';
    }


    // ==================================
    // 3. inviteCodes
    // ==================================

    match /inviteCodes/{code} {

      // 코드를 알고 있는 로그인 사용자만
      // 해당 문서 ID로 직접 조회 가능
      allow get: if signedIn();

      allow list: if false;


      // ----------------------------------
      // 초대코드 생성
      // ----------------------------------

      allow create: if signedIn()

      && validInviteCode(code)

      && request.resource.data.keys().hasOnly([
        'ownerUid',
        'galaxyId',
        'createdAt'
      ])

      && request.resource.data.keys().hasAll([
        'ownerUid',
        'galaxyId',
        'createdAt'
      ])

      && request.resource.data.ownerUid
      == request.auth.uid

      && request.resource.data.galaxyId is string

      && request.resource.data.createdAt == request.time

      && getAfter(
        galaxyPath(request.resource.data.galaxyId)
      ).data.ownerUid == request.auth.uid

      && getAfter(
        galaxyPath(request.resource.data.galaxyId)
      ).data.status == 'waiting'

      && getAfter(
        galaxyPath(request.resource.data.galaxyId)
      ).data.inviteCode == code;


      allow update: if false;


      // ----------------------------------
      // 초대코드 삭제 및 무효화
      // ----------------------------------

      allow delete: if signedIn()
      && (
        // 코드 소유자가 직접 삭제
        request.auth.uid == resource.data.ownerUid

        ||

        // 커플 합류 과정에서 코드 소모
        (
          resource.data.galaxyId is string

          && exists(galaxyPath(resource.data.galaxyId))

          && get(
            galaxyPath(resource.data.galaxyId)
          ).data.status == 'waiting'

          && get(
            galaxyPath(resource.data.galaxyId)
          ).data.ownerUid == resource.data.ownerUid

          && get(
            galaxyPath(resource.data.galaxyId)
          ).data.inviteCode == code

          && getAfter(
            galaxyPath(resource.data.galaxyId)
          ).data.status == 'naming'

          && getAfter(
            galaxyPath(resource.data.galaxyId)
          ).data.inviteCode == null

          && request.auth.uid in getAfter(
            galaxyPath(resource.data.galaxyId)
          ).data.memberUids

          && !(request.auth.uid in get(
            galaxyPath(resource.data.galaxyId)
          ).data.memberUids)

          && getAfter(
            galaxyPath(resource.data.galaxyId)
          ).data.memberUids.size() == 2
        )
      );
    }


    // ==================================
    // 4. 우주 재판장 공통 함수
    // ==================================

    function courtPostPath(postId) {
      return /databases/$(database)/documents/courtPosts/$(postId);
    }

    function courtVotePath(postId, uid) {
      return /databases/$(database)/documents/courtPosts/$(postId)/votes/$(uid);
    }

    function courtLessonPath(postId, uid) {
      return /databases/$(database)/documents/courtPosts/$(postId)/lessons/$(uid);
    }

    // 화해 기록은 현재 연동된 커플만 접근
    function canAccessCourtLessons(postId) {
      return signedIn()

      && request.auth.uid in get(
        courtPostPath(postId)
      ).data.memberUids

      && isActiveGalaxyMember(
        get(courtPostPath(postId)).data.galaxyId
      )

      && get(
        galaxyPath(
          get(courtPostPath(postId)).data.galaxyId
        )
      ).data.status == 'active';
    }


    // ==================================
    // 5. courtPosts
    // ==================================

    match /courtPosts/{postId} {

      // 재판 상세 조회
      allow get: if signedIn();

      // 재판 목록 조회
      allow list: if signedIn()
      && request.query.limit != null
      && request.query.limit <= 50;


      // ----------------------------------
      // 재판 생성
      // ----------------------------------

      allow create: if signedIn()

      && request.resource.data.keys().hasOnly([
        'title',
        'situation',
        'positionA',
        'positionB',
        'galaxyId',
        'galaxyName',
        'authorUid',
        'memberUids',
        'votesA',
        'votesB',
        'createdAt',
        'deadlineAt',
        'resolvedAt'
      ])

      && request.resource.data.keys().hasAll([
        'title',
        'situation',
        'positionA',
        'positionB',
        'galaxyId',
        'galaxyName',
        'authorUid',
        'memberUids',
        'votesA',
        'votesB',
        'createdAt',
        'deadlineAt',
        'resolvedAt'
      ])

      && request.resource.data.authorUid
      == request.auth.uid

      && request.resource.data.galaxyId is string

      && get(
        galaxyPath(request.resource.data.galaxyId)
      ).data.status == 'active'

      && request.resource.data.memberUids
      == get(
        galaxyPath(request.resource.data.galaxyId)
      ).data.memberUids

      && request.resource.data.memberUids.size() == 2

      && request.auth.uid in
      request.resource.data.memberUids

      && request.resource.data.galaxyName
      == get(
        galaxyPath(request.resource.data.galaxyId)
      ).data.name

      // 제목 검사
      && request.resource.data.title is string
      && request.resource.data.title.size() >= 1
      && request.resource.data.title.size() <= 100

      // 상황 설명 검사
      && request.resource.data.situation is string
      && request.resource.data.situation.size() >= 1
      && request.resource.data.situation.size() <= 2000

      // 입장 A 검사
      && request.resource.data.positionA is string
      && request.resource.data.positionA.size() >= 1
      && request.resource.data.positionA.size() <= 1000

      // 입장 B 검사
      && request.resource.data.positionB is string
      && request.resource.data.positionB.size() >= 1
      && request.resource.data.positionB.size() <= 1000

      // 초기 투표 수
      && request.resource.data.votesA == 0
      && request.resource.data.votesB == 0

      // 최초 생성 상태
      && request.resource.data.resolvedAt == null
      && request.resource.data.createdAt == request.time

      // 투표 마감은 약 24시간 후
      && request.resource.data.deadlineAt is timestamp

      && request.resource.data.deadlineAt >
      request.time + duration.value(23, 'h')

      && request.resource.data.deadlineAt <
      request.time + duration.value(25, 'h');


      // ----------------------------------
      // 투표 집계 및 화해 완료
      // ----------------------------------

      allow update: if signedIn()
      && (

        // A/B 투표 집계
        (
          !(request.auth.uid in resource.data.memberUids)

          && resource.data.resolvedAt == null

          && request.time < resource.data.deadlineAt

          && onlyChanges([
            'votesA',
            'votesB'
          ])

          // 중복 투표 방지
          && !exists(
            courtVotePath(postId, request.auth.uid)
          )

          // 투표 기록이 함께 생성되어야 함
          && existsAfter(
            courtVotePath(postId, request.auth.uid)
          )

          && (
            // A 선택
            (
              getAfter(
                courtVotePath(postId, request.auth.uid)
              ).data.choice == 1

              && request.resource.data.votesA
              == resource.data.votesA + 1

              && request.resource.data.votesB
              == resource.data.votesB
            )

            ||

            // B 선택
            (
              getAfter(
                courtVotePath(postId, request.auth.uid)
              ).data.choice == 2

              && request.resource.data.votesB
              == resource.data.votesB + 1

              && request.resource.data.votesA
              == resource.data.votesA
            )
          )
        )

        ||

        // 커플 양쪽이 배운 점을 작성하면 화해
        (
          request.auth.uid in resource.data.memberUids

          && resource.data.memberUids.size() == 2

          && isActiveGalaxyMember(
            resource.data.galaxyId
          )

          && get(
            galaxyPath(resource.data.galaxyId)
          ).data.status == 'active'

          && resource.data.resolvedAt == null

          && request.resource.data.resolvedAt
          == request.time

          && onlyChanges([
            'resolvedAt'
          ])

          && existsAfter(
            courtLessonPath(
              postId,
              resource.data.memberUids[0]
            )
          )

          && existsAfter(
            courtLessonPath(
              postId,
              resource.data.memberUids[1]
            )
          )
        )
      );


      allow delete: if false;


      // ==================================
      // 6. 사용자별 투표
      // ==================================

      match /votes/{voterUid} {

        // 본인 투표만 조회
        allow get: if signedIn()
        && request.auth.uid == voterUid;

        allow list: if false;


        // 투표 생성
        allow create: if signedIn()

        && request.auth.uid == voterUid

        && request.resource.data.keys().hasOnly([
          'choice',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'choice',
          'createdAt'
        ])

        && request.resource.data.choice in [1, 2]

        && request.resource.data.createdAt == request.time

        // 재판 당사자는 투표 불가
        && !(request.auth.uid in get(
          courtPostPath(postId)
        ).data.memberUids)

        // 화해 후 투표 불가
        && get(
          courtPostPath(postId)
        ).data.resolvedAt == null

        // 마감 후 투표 불가
        && request.time <
        get(courtPostPath(postId)).data.deadlineAt

        // 투표 기록과 집계가 일치해야 함
        && (
          // A 투표
          (
            request.resource.data.choice == 1

            && getAfter(
              courtPostPath(postId)
            ).data.votesA
            == get(
              courtPostPath(postId)
            ).data.votesA + 1

            && getAfter(
              courtPostPath(postId)
            ).data.votesB
            == get(
              courtPostPath(postId)
            ).data.votesB
          )

          ||

          // B 투표
          (
            request.resource.data.choice == 2

            && getAfter(
              courtPostPath(postId)
            ).data.votesB
            == get(
              courtPostPath(postId)
            ).data.votesB + 1

            && getAfter(
              courtPostPath(postId)
            ).data.votesA
            == get(
              courtPostPath(postId)
            ).data.votesA
          )
        );

        // 투표 기록은 생성 후 수정·삭제 불가
        allow update, delete: if false;

      }


      // ==================================
      // 7. 커플 화해 기록
      // ==================================

      match /lessons/{memberUid} {

        // 현재 연동된 커플만 조회
        allow get, list: if
        canAccessCourtLessons(postId);


        // 본인의 배운 점만 최초 한 번 작성
        allow create: if signedIn()

        && request.auth.uid == memberUid

        && canAccessCourtLessons(postId)

        && get(
          courtPostPath(postId)
        ).data.resolvedAt == null

        && request.resource.data.keys().hasOnly([
          'lesson',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'lesson',
          'createdAt'
        ])

        && request.resource.data.lesson is string

        && request.resource.data.lesson.size() >= 1

        && request.resource.data.lesson.size() <= 2000

        && request.resource.data.createdAt == request.time;

        allow update, delete: if false;


      } // lessons 규칙 종료

    } // courtPosts 규칙 종료


    // ==================================
    // 8. 행성 생성 및 사진 저장
    // ==================================

    match /galaxies/{galaxyId}/planets/{planetId} {

      // 같은 은하계의 커플만 행성 조회 가능
      allow get, list: if signedIn()
      && request.auth.uid in
      get(galaxyPath(galaxyId)).data.memberUids;

      // 활성 은하계 구성원만 행성 생성 가능
      allow create: if signedIn()

      && request.auth.uid in
      get(galaxyPath(galaxyId)).data.memberUids

      && get(galaxyPath(galaxyId)).data.status == 'active'

      && request.resource.data.keys().hasOnly([
        'createdBy',
        'planetAsset',
        'photoCount',
        'photos',
        'createdAt'
      ])

      && request.resource.data.keys().hasAll([
        'createdBy',
        'planetAsset',
        'photoCount',
        'photos',
        'createdAt'
      ])

      && request.resource.data.createdBy == request.auth.uid


      && request.resource.data.planetAsset in [
        'planet_01',
        'planet_02',
        'planet_03',
        'planet_04',
        'planet_05',
        'planet_06'
      ]


      && request.resource.data.photos is list

      && request.resource.data.photoCount is int

      && request.resource.data.photoCount >= 1

      && request.resource.data.photoCount <= 100

      && request.resource.data.photos.size()
      == request.resource.data.photoCount

      && request.resource.data.createdAt == request.time;

      // 행성 수정 및 삭제는 추후 구현

      // 행성 사진 정보 수정 및 사진 추가
      allow update: if signedIn()

      && exists(galaxyPath(galaxyId))

      && get(galaxyPath(galaxyId)).data.status == 'active'

      && request.auth.uid in
      get(galaxyPath(galaxyId)).data.memberUids

      // 수정 가능한 최상위 필드 제한
      && onlyChanges([
        'photos',
        'photoCount',
        'updatedAt'
      ])

      && resource.data.photos is list
      && request.resource.data.photos is list
      && request.resource.data.photoCount is int

      // 사진 개수 검증
      && request.resource.data.photoCount
      == request.resource.data.photos.size()

      && request.resource.data.photoCount >= 1
      && request.resource.data.photoCount <= 100

      // 기존 사진 설명·날짜 수정 또는 새 사진 추가
      && (
        (
          request.resource.data.photoCount
          == resource.data.photoCount

          && request.resource.data.photos.size()
          == resource.data.photos.size()
        )
        ||
        (
          request.resource.data.photoCount
          > resource.data.photoCount

          // 추가할 때 기존 사진 기록 유지
          && request.resource.data.photos.hasAll(
            resource.data.photos
          )
        )
      )

      && request.resource.data.updatedAt == request.time;

      allow delete: if false;


    }


    // ==================================
    // 9. 팀원 담당 컬렉션 임시 규칙
    // ==================================

    match /planets/{document=**} {
      allow read, write: if signedIn();
    }

    match /blackholes/{document=**} {
      allow read, write: if signedIn();
    }

    match /trials/{document=**} {
      allow read, write: if signedIn();
    }

    match /messages/{document=**} {
      allow read, write: if signedIn();
    }

    // Firebase 연결 테스트용
    match /connection_tests/{uid} {
      allow read, write: if signedIn()
      && request.auth.uid == uid;
    }

  } // documents 종료

} // service 종료
